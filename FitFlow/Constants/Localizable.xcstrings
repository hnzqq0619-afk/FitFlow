          }
        }
      }
    },
    "onboard_desc_2": {
      "comment": "Second onboarding screen description.",
      "extractionState": "stale",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log weight and view trends. Apple Health is optional."
          }
